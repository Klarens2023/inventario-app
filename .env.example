# Plantilla de variables de entorno. Copia a .env.local (no se versiona) y llena
# los valores. Nunca subas valores reales al repositorio. Detalle: docs/ENVIRONMENT.md

# ─── BASE DE DATOS (Neon PostgreSQL) ───────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/inventario?sslmode=require"

# ─── AUTENTICACIÓN (NextAuth) ───────────────────────────────────────────────
# Firma la cookie de sesión web y el JWT de la app móvil. Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="genera-un-secreto-aleatorio-aqui"
# En desarrollo; en Vercel se toma la URL del despliegue
NEXTAUTH_URL="http://localhost:3000"

# ─── GOOGLE DRIVE (fotos de pagos QR, cierres de datafono y formatos TIC) ───
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Llave privada de la cuenta de servicio, con los saltos de línea como \n
GOOGLE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""

# ─── SINCRONIZACIÓN PROGRAMADA DE ÓRDENES EDI ───────────────────────────────
# Misma clave que el secreto CRON_SECRET del workflow de GitHub Actions
CRON_SECRET=""

# ─── SFTP DE ÓRDENES EDI (solo lectura) ─────────────────────────────────────
CARVAJAL_SFTP_HOST=""
CARVAJAL_SFTP_PORT="22"
CARVAJAL_SFTP_USER=""
CARVAJAL_SFTP_PASSWORD=""
CARVAJAL_SFTP_DIR=""
SUBRIK_SFTP_HOST=""
SUBRIK_SFTP_PORT="22"
SUBRIK_SFTP_USER=""
SUBRIK_SFTP_PASSWORD=""
SUBRIK_SFTP_DIR=""

# ─── API CONNEKTA DE SIESA ──────────────────────────────────────────────────
SIESA_CLIENT_ID=""
SIESA_CONNI_KEY=""
SIESA_CONNI_TOKEN=""
# Opcionales (tienen valor por defecto en lib/siesa/connekta.ts y lib/cen/pedidoSiesa.ts)
# SIESA_API_URL=""            # por defecto el ambiente QA
# SIESA_ID_COMPANIA=""
# SIESA_CIA=""
# SIESA_ID_DOCUMENTO_PEDIDO=""
# SIESA_NOMBRE_DOCUMENTO_PEDIDO=""
# SIESA_TIPO_DOCTO_PEDIDO=""  # por defecto PVS
# SIESA_EXT1_DETALLE=""       # por defecto FN

# IPs públicas de la empresa (IPs o rangos CIDR separados por coma): no cuentan
# para el límite de login por IP (lib/ipConfianza.ts). El bloqueo por usuario sigue aplicando.
LOGIN_IPS_CONFIANZA="190.242.100.248/29"
